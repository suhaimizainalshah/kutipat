{
  "manifest_version": 3,
  "name": "Kutipat: Private Web Data Scraper",
  "short_name": "Kutipat",
  "version": "1.0.0",
  "description": "Turn tables and lists on any page into a spreadsheet, across pages. No tracking, no account, nothing leaves your browser.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Kutipat: scrape this page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "omnibox": {
    "keyword": "kutip"
  }
}